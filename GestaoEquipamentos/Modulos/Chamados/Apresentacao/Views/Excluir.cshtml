@model ExcluirChamadoViewModel

@{
    Layout = "_Layout";
    ViewBag.Titulo = "Exclusão de Chamado";
}

<div class="row justify-content-start">
    <div class="col-lg-6">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Tem certeza que deseja excluir?</h4>
            <p>Esta ação não poderá ser desfeita.</p>
            <hr>

            <p class="mb-1"><strong>Título:</strong> @Model.Titulo</p>
            <p class="mb-0"><strong>Equipamento Afetado:</strong> @Model.NomeEquipamento</p>
        </div>

        <form asp-action="Excluir" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-3 mt-4">
                <button class="btn btn-danger" type="submit">
                    <i class="bi bi-trash"></i>
                    Confirmar exclusão
                </button>
                <a class="btn btn-outline-secondary" asp-action="Listar">
                    <i class="bi bi-arrow-return-left"></i>
                    Voltar para a lista
                </a>
            </div>
        </form>
    </div>
</div>